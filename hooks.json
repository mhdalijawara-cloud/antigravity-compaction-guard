{
  "compaction-guard": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/compaction_guard.py post-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ./scripts/compaction_guard.py pre-invocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ./scripts/compaction_guard.py stop",
        "timeout": 10
      }
    ]
  }
}
